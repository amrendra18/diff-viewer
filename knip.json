{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/app/preload.ts",
    "src/app/highlight-worker.ts",
    "src/web/renderer.ts",
    "tests/**/*.test.mts",
    "scripts/{check,fixtures,hand-journey,package,start,verify}.mts"
