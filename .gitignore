# Purpose: Excludes private, generated, and machine-local files from Git.
# Scope: Applies to repository working-tree discovery.

# Private drafts and local working material
.local/
/PLAN.md
/BLOCKED.md

# Operating-system and editor state
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local environments and secrets
.env
.env.*
*.env
*.env.*
!.env.example
!.env.schema
!.env.template
.venv/
venv/
.secrets/

# Python output
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Installed packages
node_modules/

# Reports and build output
*.log
.coverage
.coverage.*
coverage.xml
htmlcov/
reports/
test-results/
dist/
build/
.cache/
tmp/
.tmp/

